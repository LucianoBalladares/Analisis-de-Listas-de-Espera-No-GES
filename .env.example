# ── Conexión a PostgreSQL ──────────────────────────────────────────
# Copiar este archivo como .env y completar con los valores reales.
# El archivo .env NO debe subirse a git (ya está en .gitignore).

DB_HOST=localhost
DB_PORT=5432
DB_NAME=listas_espera_ges
DB_USER=postgres
DB_PASSWORD=tu_password_aqui

# ── Notas para WSL ─────────────────────────────────────────────────
# Si PostgreSQL corre dentro de WSL, DB_HOST=localhost funciona
# para conexiones desde el mismo WSL.
# Para conectar desde Windows (Power BI), ver docs/powerbi_wsl.md